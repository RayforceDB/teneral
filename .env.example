# ./box setup writes this file for you, after testing the provider. This is for writing it by hand.
# Values go in plain: no quotes, no comment after a value. Docker passes the line on as written.

# Which provider (kernel/providers.ts):
#   compatible  any OpenAI-compatible chat-completions endpoint. Needs the three lines below. The default.
#   openai      an OpenAI API key, over the Responses API. Needs the three lines below, with https://api.openai.com/v1.
#   chatgpt     your ChatGPT plan. Needs TENERAL_MODEL only, and a sign-in, which only ./box setup can make:
#               it is stored in .teneral/auth/, not here. Leave TENERAL_BASE_URL and TENERAL_API_KEY out.
TENERAL_PROVIDER=compatible
TENERAL_BASE_URL=https://example.invalid/v1
TENERAL_API_KEY=
TENERAL_MODEL=
# Minutes between clock stimuli. 0 turns the clock off.
TENERAL_HEARTBEAT_MINUTES=30
# Characters of context sent per request. Unset, or not a positive number: 250000.
# Lower it when the agent reports that the conversation no longer fits the model.
# TENERAL_CONTEXT_CHARS=250000
