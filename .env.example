# ./one setup writes this file for you, after testing the provider. This is for writing it by hand.
# Values go in plain: no quotes, no comment after a value. Docker passes the line on as written.

# Which provider (brain/providers.ts):
#   compatible  any OpenAI-compatible chat-completions endpoint. Needs the three lines below. The default.
#   openai      an OpenAI API key, over the Responses API. Needs the three lines below, with https://api.openai.com/v1.
#   chatgpt     your ChatGPT plan. Needs TENERAL_MODEL only, and a sign-in, which only ./one setup can make:
#               it is stored in .teneral/auth/, not here. Leave TENERAL_BASE_URL and TENERAL_API_KEY out.
TENERAL_PROVIDER=compatible
TENERAL_BASE_URL=https://example.invalid/v1
TENERAL_API_KEY=
TENERAL_MODEL=
# Minutes between clock stimuli. 0 turns the clock off.
TENERAL_HEARTBEAT_MINUTES=30
# Characters of context sent per request. Unset, or not a positive number: 250000.
# Lower it when the agent reports that the conversation no longer fits the model.
# TENERAL_CONTEXT_CHARS=250000
# Characters of the conversation shown word for word; what is older is shown as the memories the agent formed of it.
# Every character is read again at each step, so this is what a step costs. Unset, or not a positive number: 100000.
# TENERAL_TAIL_CHARS=100000
# Tokens a day the agent may spend in time of its own, the turns a clock tick wakes it for. Past it there are no ticks until
# the day has moved on; what you or anyone else sends is answered all the same. Unset, or not a positive number: no cap.
# TENERAL_OWN_TOKENS_DAY=2000000
# Hours between the reports the agent makes to you of what it did on its own: one short message, by the way it chooses, and only
# when there is something to tell. Unset: 24. 0: none.
# TENERAL_REPORT_HOURS=24
# The species: the ref whose stem and project files this lineage may take, as <remote>/<branch> or a local branch.
# Unset: origin/main when there is a remote origin, else the branch this checkout is on.
# TENERAL_UPSTREAM=origin/main
# Whether a mutation may change anything outside the agent's body, its stem included: ask (you approve each
# such commit with ./one approve or /approve first), auto, or off. Unset, or anything else: ask.
# TENERAL_APPROVAL=ask
# Images sent with one request: the newest ones your agent was shown. Unset, or not a whole number: 4. 0 sends none.
# Each counts as 12000 characters of the context above, whatever its size on disk.
# TENERAL_IMAGES_PER_REQUEST=4
# Whether the agent may offer changes to the species, as pull requests, and report on others' (README,
# "Offering a change to the species"): ask (the default: you approve each commit), auto, or off.
# TENERAL_PUBLISH=ask

# Your fork of the species on GitHub, as owner/name: where an offer is pushed, and where its pull request
# is opened from. Unset: your repository of the species' name, found by asking GitHub whose token it is.
# TENERAL_FORK=
# TENERAL_CHECK_MINUTES=10
# TENERAL_SMOKE_SECONDS=30
