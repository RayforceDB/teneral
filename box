#!/usr/bin/env bash
# Run teneral inside its container. The repo is the only thing it can see.
set -euo pipefail
cd "$(dirname "$0")"

usage() {
  cat <<'EOF'
usage: ./box <command>

  setup           choose the model provider, sign in or enter a key, and test it; writes .env.
                  Run again to change provider or to sign in again
  up              start the agent in the background; it outlives this terminal.
                  The first time, with no .env yet, it runs the setup first
  talk            attach this terminal to it: the conversation is printed into the terminal as
                  any output is, with a box to type in under it. Enter sends, Ctrl+V attaches
                  the image in the clipboard, /help lists the rest; /quit, Ctrl-D or Ctrl-C
                  leaves. The agent goes on.
                  With its input from a pipe it is plain text, one line in and the reply out:
                  echo "..." | ./box talk [--wait <seconds>]
  down            stop the agent
  back [<commit>] send the agent back to the generation before, or to the earlier one named;
                  --list shows the generations it has lived in. A running agent is stopped
                  for it and started again
  approve [<commit>]
                  approve the mutation the agent asked for that changes something outside its
                  body, its kernel included, or the commit named. /approve in talk does the same
  logs            follow what the kernel and the agent print
  offer <command> what the agent offers to the species: `offer list` shows what was checked and
                  what waits for you, `offer approve <commit>` lets exactly that commit go out,
                  `offer token` stores the GitHub token publishing needs, `offer key` prints
                  this individual's public signing key. `offer help` lists the rest
  run <command>   run a command in a fresh container instead of the agent: ./box run bun test
  fg              run the agent in the foreground of this terminal, for debugging

talk and setup take --plain: plain text at a terminal too, without the panel, the input box and
the setup's screens. NO_COLOR is honoured.

Only setup ever opens a port, and only for the ChatGPT sign-in: 127.0.0.1:1455 on this machine,
where your browser is sent back to after you sign in. TENERAL_CALLBACK_PORT chooses another.
EOF
}

# The agent's container is named after this directory: a second agent for it is then refused,
# while `run` commands, which get no name, can run beside it.
name="teneral-$(basename "$PWD")"
# The image. A development checkout that must not replace the image of an install beside it names another.
image="${BOX_IMAGE:-teneral}"

# What that container is doing: running, exited, ... or nothing when there is none.
state() { docker container inspect --format '{{.State.Status}}' "$name" 2>/dev/null || true; }
exit_code() { docker container inspect --format '{{.State.ExitCode}}' "$name" 2>/dev/null || true; }
alive() {
  case "$(state)" in
    running | paused | restarting) return 0 ;;
    *) return 1 ;;
  esac
}

say_not_running() {
  if [ -n "$(state)" ]; then
    echo "Not running: it stopped by itself, with status $(exit_code). ./box logs shows its last lines, ./box up starts it again." >&2
  else
    echo "Not running. ./box up starts it." >&2
  fi
}

# A container that stopped by itself (the agent quit, or the kernel gave up and needs you) is
# kept so that its output can still be read. It goes when the next one starts.
clear_stopped() {
  [ -n "$(state)" ] || return 0
  echo "The last run stopped by itself, with status $(exit_code). Its last lines:"
  docker logs --tail 10 "$name" 2>&1 | sed 's/^/  | /'
  docker rm "$name" >/dev/null
}

# What of this script's must not outlive it: a file, and the helper that `talk` starts with the
# directory it shares with the client.
tmp=""
clip_pid=""
clip_dir=""
cleanup() {
  [ -z "$tmp" ] || rm -f "$tmp"
  [ -z "$clip_pid" ] || kill "$clip_pid" 2>/dev/null || true
  [ -z "$clip_dir" ] || clip_clear "$clip_dir"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 143' TERM

# The (${x[@]+...}) form below is for bash before 4.4, where an empty array counts as unset.
tty=()
extra=()
build() {
  # Nothing is said when the build works, whatever docker prints while at it: that is kept, and
  # shown only if the build fails. A build that takes more than a moment gets one line.
  local pid waited=0
  tmp="$(mktemp)"
  docker build --quiet --tag "$image" \
    --build-arg "UID=$(id -u)" --build-arg "GID=$(id -g)" . >"$tmp" 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    sleep 0.1
    waited=$((waited + 1))
    if [ "$waited" -eq 15 ]; then echo "Preparing the container ..." >&2; fi
  done
  if ! wait "$pid"; then
    cat "$tmp" >&2
    echo "The container image could not be built." >&2
    exit 1
  fi
  rm -f "$tmp"
  tmp=""
  # No -t when stdin is not a terminal, so this also works from a script or a service.
  if [ -t 0 ]; then tty=(--tty); fi
  # More options for `docker run`, split on spaces. Nothing here needs any; it is for an unusual
  # host, a limit such as --memory or --pids-limit, or a test that has to reach a model server on
  # the machine itself.
  if [ -n "${BOX_DOCKER_ARGS:-}" ]; then read -r -a extra <<<"$BOX_DOCKER_ARGS"; fi
}

prepare() {
  if [ ! -f .env ]; then
    echo "No .env here, so no model provider is configured. ./box setup makes one." >&2
    exit 1
  fi
  build
}

# --init puts a small init at pid 1: it passes signals on to the kernel and reaps what the
# agent's shell leaves behind.
# No memory or process limit is set here; an owner who wants one passes it in BOX_DOCKER_ARGS.
bare=(--init
  --volume "$PWD":/teneral
  --cap-drop ALL
  --security-opt no-new-privileges)
# The agent and its commands also get the owner's configuration. The setup, which writes it, does not.
cage=("${bare[@]}" --env-file .env)

# What a program in the container has to know about this terminal to draw on it: its kind, its
# colours, whether NO_COLOR is set, and whether its locale is UTF-8. The image has the locale
# C.UTF-8 and no other, so that is the one named. Resizing needs nothing here: docker passes it on.
term_env=()
terminal_env() {
  term_env=(--env "TERM=${TERM:-dumb}")
  if [ -n "${COLORTERM:-}" ]; then term_env+=(--env "COLORTERM=$COLORTERM"); fi
  if [ -n "${NO_COLOR:-}" ]; then term_env+=(--env "NO_COLOR=$NO_COLOR"); fi
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) term_env+=(--env LANG=C.UTF-8) ;;
    *) term_env+=(--env LANG=C) ;;
  esac
}

# --- images for the talk client ---
#
# The client runs inside the container, where there is no clipboard and no file of this machine.
# So `talk` starts a helper here, for as long as the client runs. The two share one directory,
# .teneral/owner/.clip/<id>/ (its name starts with a dot, which the agent's reader of the owner's
# lines skips), and talk through files in it, because files are what crosses the mount on every
# kind of Docker: the client leaves `req-N`, holding an action from a fixed set and, for a file,
# its path; the helper answers with `rep-N`, and with the bytes in `dat-N`. Every file is written
# aside and renamed. Nothing a request holds is ever run: a path is only read.

clip_limit=10485760

# How this machine's clipboard can be read, or why it cannot.
clip_tool() {
  if [ "$(uname -s)" = Darwin ]; then
    if command -v pngpaste >/dev/null 2>&1; then echo pngpaste; else echo osascript; fi
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then
    echo wl-paste
  elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
    echo xclip
  elif [ -n "${WAYLAND_DISPLAY:-}" ]; then
    echo "none wayland"
  elif [ -n "${DISPLAY:-}" ]; then
    echo "none x11"
  else
    echo "none headless"
  fi
}

# clip_reply <dir> <n> <first line>: the answer, whole or not at all.
clip_reply() {
  printf '%s\n' "$3" >"$1/.rep-$2.tmp" && mv -f "$1/.rep-$2.tmp" "$1/rep-$2"
}

# Run a clipboard tool, but not for ever: a clipboard whose owner does not answer would hang it.
clip_run() {
  if command -v timeout >/dev/null 2>&1; then timeout 5 "$@"; else "$@"; fi
}

# The first image type a list of offered types holds, PNG before the others.
clip_pick() {
  local want
  for want in image/png image/jpeg image/gif image/webp; do
    if printf '%s\n' "$1" | grep -qxF "$want"; then
      echo "$want"
      return 0
    fi
  done
  return 1
}

# clip_save <dir> <n> <tool>: the clipboard's image into dat-N, as it is. Nothing is converted.
clip_save() {
  local dir="$1" n="$2" tool="$3" out="$1/.dat-$2.tmp" types type size
  : >"$out"
  case "$tool" in
    xclip)
      types="$(clip_run xclip -selection clipboard -t TARGETS -o 2>/dev/null || true)"
      if type="$(clip_pick "$types")"; then clip_run xclip -selection clipboard -t "$type" -o >"$out" 2>/dev/null || true; fi
      ;;
    wl-paste)
      types="$(clip_run wl-paste --list-types 2>/dev/null || true)"
      if type="$(clip_pick "$types")"; then clip_run wl-paste --no-newline --type "$type" >"$out" 2>/dev/null || true; fi
      ;;
    pngpaste)
      pngpaste "$out" >/dev/null 2>&1 || true
      ;;
    osascript)
      # The path goes in as an argument, never into the script's text.
      osascript -e 'on run argv' \
        -e 'set png to the clipboard as «class PNGf»' \
        -e 'set f to open for access (POSIX file (item 1 of argv)) with write permission' \
        -e 'set eof f to 0' -e 'write png to f' -e 'close access f' -e 'end run' "$out" >/dev/null 2>&1 || true
      ;;
    *)
      rm -f "$out"
      clip_reply "$dir" "$n" "error no-tool"
      return 0
      ;;
  esac
  size=0
  if [ -f "$out" ]; then size="$(wc -c <"$out" | tr -d ' ')"; fi
  if [ "$size" -eq 0 ]; then
    rm -f "$out"
    clip_reply "$dir" "$n" "error no-image"
  elif [ "$size" -gt "$clip_limit" ]; then
    rm -f "$out"
    clip_reply "$dir" "$n" "error too-large $size"
  else
    mv -f "$out" "$dir/dat-$n"
    clip_reply "$dir" "$n" ok
  fi
}

# clip_file <dir> <n> <path>: a file of this machine into dat-N, if its first bytes say it is a
# PNG, JPEG, GIF or WebP image and it is not too large. The file is read, and nothing else.
clip_file() {
  local dir="$1" n="$2" path="$3" size magic
  case "$path" in
    "~/"*) path="$HOME/${path#"~/"}" ;;
    /*) ;;
    *)
      clip_reply "$dir" "$n" "error not-found"
      return 0
      ;;
  esac
  if [ ! -e "$path" ]; then
    clip_reply "$dir" "$n" "error not-found"
  elif [ ! -f "$path" ] || [ ! -r "$path" ]; then
    clip_reply "$dir" "$n" "error not-file"
  else
    size="$(wc -c <"$path" | tr -d ' ')"
    magic="$(head -c 12 "$path" | od -An -v -tx1 | tr -d ' \n')"
    case "$magic" in
      89504e470d0a1a0a* | ffd8ff* | 474946383761* | 474946383961* | 52494646????????57454250) ;;
      *)
        clip_reply "$dir" "$n" "error not-image"
        return 0
        ;;
    esac
    if [ "$size" -gt "$clip_limit" ]; then
      clip_reply "$dir" "$n" "error too-large $size"
    elif cp "$path" "$dir/.dat-$n.tmp" 2>/dev/null && mv -f "$dir/.dat-$n.tmp" "$dir/dat-$n"; then
      clip_reply "$dir" "$n" ok
    else
      rm -f "$dir/.dat-$n.tmp"
      clip_reply "$dir" "$n" "error not-file"
    fi
  fi
}

# The helper itself: says how the clipboard can be read, then answers requests a few times a
# second until its directory goes, or the script that started it does.
clip_helper() {
  local dir="$1" parent="$2" tool req n action path
  set +e
  tool="$(clip_tool)"
  printf '%s\n' "$tool" >"$dir/.helper.tmp" && mv -f "$dir/.helper.tmp" "$dir/helper"
  while [ -d "$dir" ] && kill -0 "$parent" 2>/dev/null; do
    for req in "$dir"/req-*; do
      [ -f "$req" ] || continue
      n="${req##*/req-}"
      action=""
      path=""
      { IFS= read -r action; IFS= read -r path; } <"$req"
      rm -f "$req"
      case "$n" in
        '' | *[!0-9]*) continue ;;
      esac
      case "$action" in
        clipboard) clip_save "$dir" "$n" "$tool" ;;
        file) clip_file "$dir" "$n" "$path" ;;
        *) clip_reply "$dir" "$n" "error unknown" ;;
      esac
    done
    sleep 0.2
  done
}

# Take one client's directory away: the few kinds of file the two ends leave there, by name, and
# then the directory, which goes only if nothing else is in it. Nothing is removed by walking.
clip_clear() {
  local dir="$1" file
  case "$dir" in
    */.teneral/owner/.clip/[0-9]*) ;;
    *) return 0 ;;
  esac
  [ -d "$dir" ] || return 0
  for file in "$dir"/helper "$dir"/req-* "$dir"/rep-* "$dir"/dat-* "$dir"/.*.tmp; do
    if [ -f "$file" ]; then rm -f "$file"; fi
  done
  rmdir "$dir" 2>/dev/null || true
}

# Start the helper for one client. The directory is named after this script's process, so one
# left behind by a script that was killed is known by its process being gone, and is cleared.
clip_env=()
clip_start() {
  local base="$PWD/.teneral/owner/.clip" old pid
  mkdir -p "$base"
  for old in "$base"/[0-9]*; do
    [ -d "$old" ] || continue
    pid="${old##*/}"
    pid="${pid%%-*}"
    case "$pid" in
      '' | *[!0-9]*) continue ;;
    esac
    kill -0 "$pid" 2>/dev/null || clip_clear "$old"
  done
  clip_dir="$base/$$-$RANDOM"
  mkdir "$clip_dir"
  clip_helper "$clip_dir" "$$" </dev/null >/dev/null 2>&1 &
  clip_pid=$!
  clip_env=(--env "TENERAL_CLIP=${clip_dir##*/}" --env "TENERAL_HOST_DIR=$PWD")
}

# Whether talk and setup will draw on the terminal: a terminal at both ends, one that takes
# escape sequences, and no --plain among the arguments. Inside the container both ends always look
# like a terminal, so when this says no, --plain is passed on.
screens() {
  [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != dumb ] || return 1
  local arg
  for arg in "$@"; do
    if [ "$arg" = --plain ]; then return 1; fi
  done
}

# A full-screen program that was cut off (its container stopped, or it was killed) could not put
# the terminal back: off the alternate screen, cursor shown, no bracketed paste.
restore_terminal() { printf '\033[?2004l\033[0m\033[?25h\033[?1049l'; }
# The talk client never leaves the normal screen. Its cursor always rests on the first row of the
# few rows it redraws, so erasing from there down takes those rows and leaves the conversation.
restore_talk() { printf '\r\033[J\033[?2004l\033[0m\033[?25h'; }

# The owner's setup (kernel/setup.ts), in a container of its own. It asks questions, so it needs a terminal.
# No port is published for it, unless the provider chosen signs in through the browser: the setup
# then ends with status 76, and is run again with the one port that sign-in comes back on, published
# on this machine's loopback address only. Inside the container the listener has to bind every
# interface for the published port to reach it; outside, nothing but 127.0.0.1 leads there.
# With the full screen, the first run leaves its last page up and the second draws over it, so
# the owner sees one setup, not two.
setup() {
  if [ ! -t 0 ]; then
    echo "./box setup asks questions and needs a terminal." >&2
    return 1
  fi
  build
  terminal_env
  local port="${TENERAL_CALLBACK_PORT:-1455}" status=0 full=1 plain=()
  if ! screens "$@"; then
    full=0
    plain=(--plain)
  fi
  docker run --rm --interactive --tty "${bare[@]}" "${term_env[@]}" ${extra[@]+"${extra[@]}"} \
    "$image" bun kernel/setup.ts --no-callback ${plain[@]+"${plain[@]}"} "$@" || status=$?
  if [ "$status" -eq 76 ]; then
    status=0
    # What docker itself says, should it fail to start this one (the port is taken, say), would be
    # lost on the screen the first run left up. It is kept, and shown once the terminal is back.
    tmp="$(mktemp)"
    docker run --rm --interactive --tty "${bare[@]}" "${term_env[@]}" ${extra[@]+"${extra[@]}"} \
      --publish "127.0.0.1:$port:$port" --env TENERAL_CALLBACK_HOST=0.0.0.0 --env "TENERAL_CALLBACK_PORT=$port" \
      "$image" bun kernel/setup.ts --resume ${plain[@]+"${plain[@]}"} "$@" 2>"$tmp" || status=$?
    if [ "$full" -eq 1 ] && [ "$status" -ge 125 ]; then restore_terminal; fi
    cat "$tmp" >&2
    rm -f "$tmp"
    tmp=""
  elif [ "$full" -eq 1 ] && [ "$status" -gt 128 ]; then
    # Killed in the middle of its screen.
    restore_terminal
  fi
  return "$status"
}

# Before the agent starts: with no configuration yet, the setup comes first when there is someone
# at a terminal to answer it; otherwise this says what to do and stops.
configure() {
  [ ! -f .env ] || return 0
  if [ ! -t 0 ]; then
    echo "No .env here, so no model provider is configured. Run ./box setup from a terminal, then this again." >&2
    exit 1
  fi
  if ! screens; then echo "No configuration here yet (.env), so the setup comes first."; fi
  # The setup's last page then says that the agent starts next, rather than naming the command for it.
  setup --then-start || exit "$?"
  if [ ! -f .env ]; then exit 1; fi
}

# The gates type-check a candidate with the project's own TypeScript, which is installed here once.
install() {
  [ ! -e node_modules ] || return 0
  echo "Installing the project's dependencies, once."
  once bun install
}

# Start the agent's container in the background and say whether it stayed up.
start() {
  # No restart policy. Docker's policies cannot tell a kernel that gave up and needs its owner
  # from a crash: `on-failure` and `unless-stopped` would both start it again, the second
  # without end. So after a reboot the agent is down until `./box up`.
  docker run --detach --name "$name" --restart no \
    "${cage[@]}" ${extra[@]+"${extra[@]}"} "$image" >/dev/null
  sleep 1
  if ! alive; then
    echo "It stopped right away, with status $(exit_code):" >&2
    docker logs --tail 20 "$name" 2>&1 | sed 's/^/  | /' >&2
    return 1
  fi
  echo "Up, as $name. ./box talk attaches to it, ./box logs follows its output, ./box down stops it."
}

# The kernel gets SIGTERM, stops the agent and exits 0. It has 20 seconds before it is killed.
stop() {
  docker stop -t 20 "$name" >/dev/null
  echo "Stopped, with status $(exit_code)."
}

# One command of the kernel's, in a container of its own beside (or instead of) the agent's.
once() {
  docker run --rm "${cage[@]}" ${extra[@]+"${extra[@]}"} "$image" "$@"
}

# Where the kernel is that answers the owner's commands (talk, back, approve), relative to this
# directory: the current generation's own, in .teneral/live, once a generation has one, else this
# checkout's. The launcher says which (kernel/launcher.ts); it is asked beside a running agent, or
# in a container of its own. This script, the Dockerfile and the launcher are the install's own and
# are the same whatever generation is current.
kernel_home() {
  local home=""
  if alive; then
    home="$(docker exec "$name" bun kernel/launcher.ts home)" || true
  else
    home="$(once bun kernel/launcher.ts home)" || true
  fi
  case "$home" in
    .teneral/live) echo .teneral/live ;;
    *) echo . ;;
  esac
}

command="${1:-}"
[ "$#" -eq 0 ] || shift

case "$command" in
  setup)
    setup "$@"
    ;;

  up)
    if alive; then
      echo "Already running, as $name."
      exit 0
    fi
    configure
    prepare
    install
    clear_stopped
    start
    ;;

  fg)
    if alive; then
      echo "Already running in the background, as $name. ./box talk attaches to it; ./box down stops it." >&2
      exit 1
    fi
    configure
    prepare
    install
    clear_stopped
    exec docker run --rm --interactive ${tty[@]+"${tty[@]}"} --name "$name" \
      "${cage[@]}" ${extra[@]+"${extra[@]}"} "$image"
    ;;

  run)
    if [ "$#" -eq 0 ]; then
      echo "run what? For example: ./box run bun test" >&2
      exit 2
    fi
    prepare
    exec docker run --rm --interactive ${tty[@]+"${tty[@]}"} \
      "${cage[@]}" ${extra[@]+"${extra[@]}"} "$image" "$@"
    ;;

  talk)
    if ! alive; then
      say_not_running
      exit 1
    fi
    # The client runs inside the container, beside the agent, so the host needs no Bun. It is the
    # client of the generation that is running, like the rest of its kernel.
    talk="$(kernel_home)/kernel/talk.ts"
    # Input from a pipe or a file: plain text, exactly as it always was.
    if [ ! -t 0 ]; then exec docker exec --interactive "$name" bun "$talk" "$@"; fi
    terminal_env
    if ! screens "$@"; then
      exec docker exec --interactive --tty "${term_env[@]}" "$name" bun "$talk" --plain "$@"
    fi
    clip_start
    status=0
    docker exec --interactive --tty "${term_env[@]}" "${clip_env[@]}" "$name" bun "$talk" "$@" || status=$?
    if [ "$status" -gt 128 ]; then
      # The client was cut off in the middle of drawing: with `./box down`, or when the kernel
      # gives up, the container goes and takes it along.
      restore_talk
      if alive; then
        echo "The talk client was cut off, with status $status. The agent goes on; ./box talk attaches again." >&2
      else
        echo "The agent stopped, and this conversation with it. ./box up starts it again." >&2
      fi
    fi
    exit "$status"
    ;;

  logs)
    if alive; then
      exec docker logs --follow --tail 100 "$name"
    fi
    if [ -n "$(state)" ]; then docker logs --tail 100 "$name" || true; fi
    say_not_running
    exit 1
    ;;

  offer)
    # The kernel's own command for offers (kernel/offer.ts), beside the agent. `approve` and
    # `token` ask at the terminal and refuse without one; the rest only read and print.
    prepare
    exec docker run --rm --interactive ${tty[@]+"${tty[@]}"} \
      "${cage[@]}" ${extra[@]+"${extra[@]}"} teneral bun kernel/offer.ts "$@"
    ;;

  down)
    if [ -z "$(state)" ]; then
      echo "Not running."
      exit 0
    fi
    if alive; then
      stop
    else
      echo "It had already stopped by itself, with status $(exit_code)."
    fi
    docker rm "$name" >/dev/null
    ;;

  back)
    prepare
    # The current generation's own kernel does it. Should that one be what is broken,
    # `./box run bun kernel/back.ts` is this checkout's.
    back="$(kernel_home)/kernel/back.ts"
    # Looking changes nothing, so the agent can stay up for it.
    case " $* " in
      *" --list "* | *" --help "* | *" -h "*)
        once bun "$back" "$@"
        exit
        ;;
    esac
    if ! alive; then
      # Down already: make the change and leave it down.
      once bun "$back" "$@"
      exit
    fi
    # The kernel refuses to change generations under a running supervisor. Ask first whether there
    # is somewhere to go, so that a request that cannot be met does not stop the agent at all.
    once bun "$back" --dry-run "$@" >/dev/null
    stop
    docker rm "$name" >/dev/null
    status=0
    once bun "$back" "$@" || status=$?
    # It was up, so it comes up again, on the earlier generation or, had the change failed, as it was.
    start || status=$?
    exit "$status"
    ;;

  approve | accept)
    prepare
    # The owner's word to the kernel: it writes a small file under .teneral/ and a line in the
    # journal, and can be said while the agent runs. A generation from before this command has
    # the one it was then, accept.ts, which accepts a species commit; that is what answers there.
    home="$(kernel_home)"
    approve="$home/kernel/approve.ts"
    [ -f "$approve" ] || approve="$home/kernel/accept.ts"
    if alive; then
      exec docker exec "$name" bun "$approve" "$@"
    fi
    once bun "$approve" "$@"
    ;;

  '' | help | -h | --help)
    usage
    ;;

  *)
    echo "./box: no such command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
