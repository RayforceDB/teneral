#!/usr/bin/env bash
# Run teneral inside its container. The repo is the only thing it can see.
set -euo pipefail
cd "$(dirname "$0")"

usage() {
  cat <<'EOF'
usage: ./box <command>

  setup           choose the model provider, sign in or enter a key, and test it; writes .env.
                  Run again to change provider or to sign in again
  up              start the agent in the background; it outlives this terminal.
                  The first time, with no .env yet, it runs the setup first
  talk            attach this terminal to it: a full screen with the conversation, what the agent
                  is doing, and a line to type on. Enter sends, PageUp and PageDown scroll,
                  /help lists the rest; /quit, Ctrl-D or Ctrl-C leaves. The agent goes on.
                  With its input from a pipe it is plain text, one line in and the reply out:
                  echo "..." | ./box talk [--wait <seconds>]
  down            stop the agent
  back [<commit>] send the agent back to the generation before, or to the earlier one named;
                  --list shows the generations it has lived in. A running agent is stopped
                  for it and started again
  logs            follow what the kernel and the agent print
  run <command>   run a command in a fresh container instead of the agent: ./box run bun test
  fg              run the agent in the foreground of this terminal, for debugging

talk and setup take --plain: plain text at a terminal too, without the full screen. NO_COLOR is
honoured.

Only setup ever opens a port, and only for the ChatGPT sign-in: 127.0.0.1:1455 on this machine,
where your browser is sent back to after you sign in. TENERAL_CALLBACK_PORT chooses another.
EOF
}

# The agent's container is named after this directory: a second agent for it is then refused,
# while `run` commands, which get no name, can run beside it.
name="teneral-$(basename "$PWD")"

# What that container is doing: running, exited, ... or nothing when there is none.
state() { docker container inspect --format '{{.State.Status}}' "$name" 2>/dev/null || true; }
exit_code() { docker container inspect --format '{{.State.ExitCode}}' "$name" 2>/dev/null || true; }
alive() {
  case "$(state)" in
    running | paused | restarting) return 0 ;;
    *) return 1 ;;
  esac
}

say_not_running() {
  if [ -n "$(state)" ]; then
    echo "Not running: it stopped by itself, with status $(exit_code). ./box logs shows its last lines, ./box up starts it again." >&2
  else
    echo "Not running. ./box up starts it." >&2
  fi
}

# A container that stopped by itself (the agent quit, or the kernel gave up and needs you) is
# kept so that its output can still be read. It goes when the next one starts.
clear_stopped() {
  [ -n "$(state)" ] || return 0
  echo "The last run stopped by itself, with status $(exit_code). Its last lines:"
  docker logs --tail 10 "$name" 2>&1 | sed 's/^/  | /'
  docker rm "$name" >/dev/null
}

# A file of this script's that must not outlive it.
tmp=""
trap '[ -z "$tmp" ] || rm -f "$tmp"' EXIT

# The (${x[@]+...}) form below is for bash before 4.4, where an empty array counts as unset.
tty=()
extra=()
build() {
  # Nothing is said when the build works, whatever docker prints while at it: that is kept, and
  # shown only if the build fails. A build that takes more than a moment gets one line.
  local pid waited=0
  tmp="$(mktemp)"
  docker build --quiet --tag teneral \
    --build-arg "UID=$(id -u)" --build-arg "GID=$(id -g)" . >"$tmp" 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    sleep 0.1
    waited=$((waited + 1))
    if [ "$waited" -eq 15 ]; then echo "Preparing the container ..." >&2; fi
  done
  if ! wait "$pid"; then
    cat "$tmp" >&2
    echo "The container image could not be built." >&2
    exit 1
  fi
  rm -f "$tmp"
  tmp=""
  # No -t when stdin is not a terminal, so this also works from a script or a service.
  if [ -t 0 ]; then tty=(--tty); fi
  # More options for `docker run`, split on spaces. Nothing here needs any; it is for an unusual
  # host, a limit such as --memory or --pids-limit, or a test that has to reach a model server on
  # the machine itself.
  if [ -n "${BOX_DOCKER_ARGS:-}" ]; then read -r -a extra <<<"$BOX_DOCKER_ARGS"; fi
}

prepare() {
  if [ ! -f .env ]; then
    echo "No .env here, so no model provider is configured. ./box setup makes one." >&2
    exit 1
  fi
  build
}

# --init puts a small init at pid 1: it passes signals on to the kernel and reaps what the
# agent's shell leaves behind.
# No memory or process limit is set here; an owner who wants one passes it in BOX_DOCKER_ARGS.
bare=(--init
  --volume "$PWD":/teneral
  --cap-drop ALL
  --security-opt no-new-privileges)
# The agent and its commands also get the owner's configuration. The setup, which writes it, does not.
cage=("${bare[@]}" --env-file .env)

# What a program in the container has to know about this terminal to draw on it: its kind, its
# colours, whether NO_COLOR is set, and whether its locale is UTF-8. The image has the locale
# C.UTF-8 and no other, so that is the one named. Resizing needs nothing here: docker passes it on.
term_env=()
terminal_env() {
  term_env=(--env "TERM=${TERM:-dumb}")
  if [ -n "${COLORTERM:-}" ]; then term_env+=(--env "COLORTERM=$COLORTERM"); fi
  if [ -n "${NO_COLOR:-}" ]; then term_env+=(--env "NO_COLOR=$NO_COLOR"); fi
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) term_env+=(--env LANG=C.UTF-8) ;;
    *) term_env+=(--env LANG=C) ;;
  esac
}

# Whether talk and setup will draw their full screen: a terminal at both ends, one that takes
# escape sequences, and no --plain among the arguments. Inside the container both ends always look
# like a terminal, so when this says no, --plain is passed on.
screens() {
  [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != dumb ] || return 1
  local arg
  for arg in "$@"; do
    if [ "$arg" = --plain ]; then return 1; fi
  done
}

# A full-screen program that was cut off (its container stopped, or it was killed) could not put
# the terminal back: off the alternate screen, cursor shown, no mouse reports, no bracketed paste.
restore_terminal() { printf '\033[?1006l\033[?1000l\033[?2004l\033[0m\033[?25h\033[?1049l'; }

# The owner's setup (kernel/setup.ts), in a container of its own. It asks questions, so it needs a terminal.
# No port is published for it, unless the provider chosen signs in through the browser: the setup
# then ends with status 76, and is run again with the one port that sign-in comes back on, published
# on this machine's loopback address only. Inside the container the listener has to bind every
# interface for the published port to reach it; outside, nothing but 127.0.0.1 leads there.
# With the full screen, the first run leaves its last page up and the second draws over it, so
# the owner sees one setup, not two.
setup() {
  if [ ! -t 0 ]; then
    echo "./box setup asks questions and needs a terminal." >&2
    return 1
  fi
  build
  terminal_env
  local port="${TENERAL_CALLBACK_PORT:-1455}" status=0 full=1 plain=()
  if ! screens "$@"; then
    full=0
    plain=(--plain)
  fi
  docker run --rm --interactive --tty "${bare[@]}" "${term_env[@]}" ${extra[@]+"${extra[@]}"} \
    teneral bun kernel/setup.ts --no-callback ${plain[@]+"${plain[@]}"} "$@" || status=$?
  if [ "$status" -eq 76 ]; then
    status=0
    # What docker itself says, should it fail to start this one (the port is taken, say), would be
    # lost on the screen the first run left up. It is kept, and shown once the terminal is back.
    tmp="$(mktemp)"
    docker run --rm --interactive --tty "${bare[@]}" "${term_env[@]}" ${extra[@]+"${extra[@]}"} \
      --publish "127.0.0.1:$port:$port" --env TENERAL_CALLBACK_HOST=0.0.0.0 --env "TENERAL_CALLBACK_PORT=$port" \
      teneral bun kernel/setup.ts --resume ${plain[@]+"${plain[@]}"} "$@" 2>"$tmp" || status=$?
    if [ "$full" -eq 1 ] && [ "$status" -ge 125 ]; then restore_terminal; fi
    cat "$tmp" >&2
    rm -f "$tmp"
    tmp=""
  elif [ "$full" -eq 1 ] && [ "$status" -gt 128 ]; then
    # Killed in the middle of its screen.
    restore_terminal
  fi
  return "$status"
}

# Before the agent starts: with no configuration yet, the setup comes first when there is someone
# at a terminal to answer it; otherwise this says what to do and stops.
configure() {
  [ ! -f .env ] || return 0
  if [ ! -t 0 ]; then
    echo "No .env here, so no model provider is configured. Run ./box setup from a terminal, then this again." >&2
    exit 1
  fi
  if ! screens; then echo "No configuration here yet (.env), so the setup comes first."; fi
  # The setup's last page then says that the agent starts next, rather than naming the command for it.
  setup --then-start || exit "$?"
  if [ ! -f .env ]; then exit 1; fi
}

# The gates type-check a candidate with the project's own TypeScript, which is installed here once.
install() {
  [ ! -e node_modules ] || return 0
  echo "Installing the project's dependencies, once."
  once bun install
}

# Start the agent's container in the background and say whether it stayed up.
start() {
  # No restart policy. Docker's policies cannot tell a kernel that gave up and needs its owner
  # from a crash: `on-failure` and `unless-stopped` would both start it again, the second
  # without end. So after a reboot the agent is down until `./box up`.
  docker run --detach --name "$name" --restart no \
    "${cage[@]}" ${extra[@]+"${extra[@]}"} teneral >/dev/null
  sleep 1
  if ! alive; then
    echo "It stopped right away, with status $(exit_code):" >&2
    docker logs --tail 20 "$name" 2>&1 | sed 's/^/  | /' >&2
    return 1
  fi
  echo "Up, as $name. ./box talk attaches to it, ./box logs follows its output, ./box down stops it."
}

# The kernel gets SIGTERM, stops the agent and exits 0. It has 20 seconds before it is killed.
stop() {
  docker stop -t 20 "$name" >/dev/null
  echo "Stopped, with status $(exit_code)."
}

# One command of the kernel's, in a container of its own beside (or instead of) the agent's.
once() {
  docker run --rm "${cage[@]}" ${extra[@]+"${extra[@]}"} teneral "$@"
}

command="${1:-}"
[ "$#" -eq 0 ] || shift

case "$command" in
  setup)
    setup "$@"
    ;;

  up)
    if alive; then
      echo "Already running, as $name."
      exit 0
    fi
    configure
    prepare
    install
    clear_stopped
    start
    ;;

  fg)
    if alive; then
      echo "Already running in the background, as $name. ./box talk attaches to it; ./box down stops it." >&2
      exit 1
    fi
    configure
    prepare
    install
    clear_stopped
    exec docker run --rm --interactive ${tty[@]+"${tty[@]}"} --name "$name" \
      "${cage[@]}" ${extra[@]+"${extra[@]}"} teneral
    ;;

  run)
    if [ "$#" -eq 0 ]; then
      echo "run what? For example: ./box run bun test" >&2
      exit 2
    fi
    prepare
    exec docker run --rm --interactive ${tty[@]+"${tty[@]}"} \
      "${cage[@]}" ${extra[@]+"${extra[@]}"} teneral "$@"
    ;;

  talk)
    if ! alive; then
      say_not_running
      exit 1
    fi
    # The client runs inside the container, beside the agent, so the host needs no Bun.
    # Input from a pipe or a file: plain text, exactly as it always was.
    if [ ! -t 0 ]; then exec docker exec --interactive "$name" bun kernel/talk.ts "$@"; fi
    terminal_env
    if ! screens "$@"; then
      exec docker exec --interactive --tty "${term_env[@]}" "$name" bun kernel/talk.ts --plain "$@"
    fi
    status=0
    docker exec --interactive --tty "${term_env[@]}" "$name" bun kernel/talk.ts "$@" || status=$?
    if [ "$status" -gt 128 ]; then
      # The client was cut off in the middle of its screen: with `./box down`, or when the kernel
      # gives up, the container goes and takes it along.
      restore_terminal
      if alive; then
        echo "The talk client was cut off, with status $status. The agent goes on; ./box talk attaches again." >&2
      else
        echo "The agent stopped, and this conversation with it. ./box up starts it again." >&2
      fi
    fi
    exit "$status"
    ;;

  logs)
    if alive; then
      exec docker logs --follow --tail 100 "$name"
    fi
    if [ -n "$(state)" ]; then docker logs --tail 100 "$name" || true; fi
    say_not_running
    exit 1
    ;;

  down)
    if [ -z "$(state)" ]; then
      echo "Not running."
      exit 0
    fi
    if alive; then
      stop
    else
      echo "It had already stopped by itself, with status $(exit_code)."
    fi
    docker rm "$name" >/dev/null
    ;;

  back)
    prepare
    # Looking changes nothing, so the agent can stay up for it.
    case " $* " in
      *" --list "* | *" --help "* | *" -h "*)
        once bun kernel/back.ts "$@"
        exit
        ;;
    esac
    if ! alive; then
      # Down already: make the change and leave it down.
      once bun kernel/back.ts "$@"
      exit
    fi
    # The kernel refuses to change generations under a running supervisor. Ask first whether there
    # is somewhere to go, so that a request that cannot be met does not stop the agent at all.
    once bun kernel/back.ts --dry-run "$@" >/dev/null
    stop
    docker rm "$name" >/dev/null
    status=0
    once bun kernel/back.ts "$@" || status=$?
    # It was up, so it comes up again, on the earlier generation or, had the change failed, as it was.
    start || status=$?
    exit "$status"
    ;;

  '' | help | -h | --help)
    usage
    ;;

  *)
    echo "./box: no such command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
